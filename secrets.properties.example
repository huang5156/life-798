# 敏感配置模板
# 复制此文件为 secrets.properties 并填入实际值
# secrets.properties 已在 .gitignore 中排除，不会被提交到版本控制

# API 网关地址
API_GATEWAY=https://example.com/api/v1

# 积分签名盐值
SIGN_SALT=your_sign_salt_here

# 客户端标识
API_CID=your_cid_here

# ---- 以下为可选：协议版本常量（一般不填，用默认值即可） ----
#
# 服务端用请求头 VersionCode 做「最低版本」校验：
# 官方 App 每次强制升级后，旧客户端会被拒绝为「请升级最新版APP」。
# APP 链路（设备控制）默认会自动读取本机已安装的官方「慧生活798」App，
# 用它的整数 versionCode 填 VersionCode 头、versionName 填 UA 后缀。
# 只有未安装官方 App 时才需要在这里手工指定。
# VERSION_CODE_MAIN=2.0.178
# VERSION_CODE_APP=31009
# APP_VERSION_NAME=3.1.9
# USER_AGENT_MAIN=WaterWidget/5.4.4 (Android)
# USER_AGENT_APP_PREFIX=Android_ilife798_
